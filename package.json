{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/quality-check.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1",
    "test:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=lib/contact.ts --test-coverage-include=lib/i18n.ts --test-coverage-include=lib/projects.ts --test-coverage-include=lib/night-concierge.ts --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "check-assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@radix-ui/react-aspect-ratio": "^1.1.11",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lenis": "^1.3.25",
    "lucide-react": "^0.460.0",
    "next": "^16.3.6",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
